# Copy to .env and fill in. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3002
# Public origin used in verification and password-reset links. In production this
# must be the live site (for example https://sbdaisolutions.onrender.com) — a
# localhost value would email links that customers cannot open. Render's
# RENDER_EXTERNAL_URL is used automatically when APP_URL is unset or local.
APP_URL=http://localhost:3001
SESSION_SECRET=replace-with-a-long-random-string
# COOKIE_SECURE=true   # set in production behind HTTPS
# Operator account for the unlisted area at /admin. ADMIN_EMAIL + ADMIN_PASSWORD
# create the account on boot and keep its password in step with this value.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional display name for that account (defaults to "Administrator").
ADMIN_NAME=
# Extra accounts that should also become operators (comma-separated). They must
# sign in with their own existing password.
ADMIN_EMAILS=

# --- Neon Postgres ---
# Leave empty locally to use the embedded PGlite database in .data/pglite
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Payments (plan subscriptions) ---
# A plan only activates after its payment is verified. Configure at least one
# method, otherwise choosing a plan tells the customer to contact you.
# Paystack: instant card/bank/USSD payments, confirmed by the server.
PAYSTACK_SECRET_KEY=
# Optional: force a currency (defaults to the plan's currency, e.g. USD).
PAYSTACK_CURRENCY=
# Bank transfer details shown on the checkout screen (verified by an operator
# from Admin -> Payments).
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_INSTRUCTIONS=

# --- OpenAI (AI assistants) ---
OPENAI_API_KEY=
# Must match OPENAI_MODEL. gpt-4o-mini (the default) is $0.15/$0.60/$0.075
# per 1M input/output/cached-input tokens on OpenAI's Standard pricing.
OPENAI_MODEL=gpt-4o-mini
# Per-1M-token prices in USD for the configured OPENAI_MODEL. If these are
# missing or invalid the AI routes reject requests instead of assuming $0.
OPENAI_INPUT_PRICE_PER_M=0.15
OPENAI_OUTPUT_PRICE_PER_M=0.60
OPENAI_CACHED_INPUT_PRICE_PER_M=0.075

# --- Email delivery (verification + password reset) ---
# Brevo is the default sender; Resend is tried automatically if Brevo fails.
# Set EMAIL_PROVIDER to brevo, resend or smtp to force which one goes first.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM="SBD AI Solutions <sbdiam.solutions@gmail.com>"
MAIL_REPLY_TO=sbdiam.solutions@gmail.com

# Optional SMTP fallback (used only if no API key is set).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
